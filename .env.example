# SIEMBox Environment Configuration
# Copy this file to .env and update with your values
# NEVER commit the .env file to version control!

# Node Environment
NODE_ENV=production

# Backend API Configuration
PORT=8421
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
# DB_HOST is `postgres` (the Compose service name) unless you've enabled the
# optional host-networking mode below, in which case change this to `localhost`.
# Only change it TOGETHER with that compose edit: `localhost`/`127.0.0.1` on the
# default bridge network makes the backend dial its own container and crash-loop
# with `connect ECONNREFUSED 127.0.0.1:5432` (and a restart won't re-read .env).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=siembox
DB_USER=siembox
DB_PASSWORD=changeme

# Security
JWT_SECRET=change-this-to-a-random-secret-key
# Initial password of the admin account, created on the first start only (when
# the database has no users); the first sign-in asks for a new one. Changing it
# later has no effect.
DEFAULT_ADMIN_PASSWORD=changeme

# Credential Encryption (scanner credentials + the AI builder API key, encrypted at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=changeme_generate_a_new_64_character_hex_key

# AI builder (optional) — provider keys. You can instead set the key in the UI
# (Settings -> AI Builder), which stores it encrypted using the key above.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Parser/detection catalog (optional overrides; defaults to cladkins/siembox-parsers).
# SIEMBOX_CATALOG_REPO=cladkins/siembox-catalog
# SIEMBOX_CATALOG_REF=main
# GITHUB_TOKEN=

# SigmaHQ library (Detection Rules > SigmaHQ). Downloads the SigmaHQ rule release
# from github.com daily; false stops that (Refresh on the page still works).
# SIGMAHQ_RELEASE_ASSET=sigma_core+.zip
# SIGMAHQ_AUTO_REFRESH=true

# SIEMBox is catalog-only by default: a fresh install ships with no bundled
# parsers or detection rules, and you install exactly what you want from the
# in-app catalog (Parsers / Detection Rules -> Browse Catalog -> Install all).
# Set this to true to opt back into auto-importing the bundled detection rules
# on startup (legacy behaviour). Defaults to catalog-only when unset.
# SEED_BUNDLED_CONTENT=true

# Browser access from other origins (CORS; DEPLOYMENT.md, "Browser access from
# other origins (CORS)"). Leave it empty: the API then answers browsers only on
# its own origin, which is all the web UI (port 8420, nginx proxies /api) and
# the Vite dev server need; shippers, endpoint agents, scripts and curl ignore
# CORS. Set it only when a page or app of yours on ANOTHER origin calls the API
# from a browser: exact origins (scheme://host[:port], no path), comma-separated:
# CORS_ORIGIN=https://dash.example.com,http://localhost:5173
# `*` lets every web page your users open call the API (password guessing and
# probing from inside your network); it still works, with a warning at every start.
CORS_ORIGIN=

# The address people use to open SIEMBox in a browser, e.g.
# https://siem.example.com (or https://example.com/siembox behind a sub-path
# reverse proxy). Notifications then link straight to the alert. Optional:
# Settings -> System -> Public URL sets it too, and wins over this. Empty: no
# links, notifications carry the ALR-#### reference only (DEPLOYMENT.md,
# "Public URL (links in notifications)").
SIEMBOX_PUBLIC_URL=

# Client addresses and reverse proxies (DEPLOYMENT.md, "Client addresses and
# reverse proxies"). The API believes X-Forwarded-For only from the bundled
# frontend (over the api-socket volume, or by its Compose service name) and
# from the proxies listed here; every other caller is its TCP address.
# Comma-separated IPs, CIDRs or Compose service names; `none` trusts only the
# socket. The value replaces the default, so keep `frontend` when you add a
# reverse proxy in front of port 8420, e.g.:
# TRUSTED_PROXIES=frontend,192.168.1.20
# General API limit: requests per 15 minutes per client address (default 1000).
# API_RATE_LIMIT_MAX=1000
# Own per-address limits of the EDR agent routes and HTTP log pushes, per 15
# minutes; raise them for a big fleet behind one address.
# EDR_AGENT_RATE_MAX=30000
# SHIPPER_LOG_PUSH_MAX=6000
# The backend's proxy socket for the frontend's nginx, on the api-socket
# volume. Leave it unset: the bundled nginx only ever connects to
# /run/siembox/api.sock, so another path leaves the web UI on TCP. `off` runs
# without the socket.
# SIEMBOX_PROXY_SOCKET=off

# Sign-in protection (DEPLOYMENT.md, "Sign-in protection"). Failed sign-ins
# pause further attempts for a while (30 seconds, doubling with every further
# failure); nothing is ever locked for good, and a browser that signed in
# before is not held back by the account-wide or network-wide pauses.
# Failures before an account pauses from one network (default 5), from one
# network for any username (default 20), and from new browsers on every
# network (default 20; 0 turns this one off):
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_ADDRESS=20
# LOGIN_MAX_FAILURES_PER_ACCOUNT=20
# Only to get back in after a lockout, then remove it again (every start logs
# a warning while it is set): stops all counting and pausing.
# LOGIN_PROTECTION=off
# Alerts about attacks on sign-in (on unless set to off), and how many days
# failed sign-in audit rows are kept (default 90; 0 keeps them).
# AUTH_ALERTS=off
# AUTH_FAILURE_AUDIT_RETENTION_DAYS=90

# Regex safety (DEPLOYMENT.md, "Regex safety checks"): the time budget for
# each of the (at most two) analyses of one parser/rule regex for catastrophic
# backtracking when it is saved (default 10000 ms; undecided = saved with a
# warning, unless the analyzer cannot read it and the fallback below cannot
# bound it), the limit for one pattern test run (default 1000 ms), worker threads
# for each (default 2), and V8's linear-time fallback for a live match that
# backtracks more than 1,000,000 times (default on; false turns it off).
# REGEX_SAFETY_CHECK_TIMEOUT_MS=10000
# REGEX_SAFETY_WORKERS=2
# REGEX_TEST_TIMEOUT_MS=1000
# REGEX_TEST_WORKERS=2
# REGEX_LINEAR_FALLBACK=true

# Frontend Configuration
VITE_API_URL=/api

# GeoIP Enrichment (DB-IP IP-to-Country Lite, CC BY 4.0)
# Path the backend reads the MMDB from (inside the container).
GEOIP_DB_PATH=/app/data/dbip-country-lite.mmdb
# Comma-separated ISO-2 home countries (e.g. US,CA). Logins from anywhere else
# get geo_foreign=true. Leave empty to disable foreign-country detection.
GEOIP_HOME_COUNTRIES=

# Container Scanning — optional Docker host image discovery.
# To list the images already running on the host (Container Scanning -> "Images
# on this Docker host"), mount the Docker socket into the backend container in
# compose.prod.yaml. WARNING: that grants the container Docker access (root-
# equivalent on the host); it is opt-in and off by default. Override the socket
# path here only if it isn't at the default location below.
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# Log Discovery: optional host networking (Linux only, backend container
# only). Lets passive discovery (ARP/mDNS/SSDP) see your real LAN instead of
# the Docker bridge. Off by default -- also requires a compose-file edit, see
# DEPLOYMENT.md's "Log Discovery and Network Visibility" section. Once you've
# made that edit: change DB_HOST above to `localhost`, then uncomment both
# lines below. BACKEND_UPSTREAM is only nginx's fallback route now (the web UI
# normally reaches the API over the api-socket volume), but host mode still
# needs it: nginx resolves it at startup, and `backend` doesn't resolve then.
# BACKEND_UPSTREAM=host.docker.internal:8421
# SIEMBOX_HOST_NETWORKING=true

# Threat Intelligence Feeds (Threat Intel page)
# Free, no-auth IP blocklists (abuse.ch Feodo/SSLBL, Tor exit nodes, blocklist.de)
# are seeded and refreshed automatically — they only need the backend to have
# OUTBOUND HTTPS egress. If egress is blocked, feeds just show last_status=error.
# Reputation providers (AbuseIPDB, AlienVault OTX) are bring-your-own-key and are
# configured in the UI (keys encrypted at rest with CREDENTIAL_ENCRYPTION_KEY) —
# there are no env vars for them.
