{
  "name": "siembox-backend",
  "version": "4.0.0",
  "description": "SIEMBox Backend - Syslog collection, parsing, and detection engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-discovery-assets.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/server.js",
    "migrate": "node dist/scripts/migrate.js",
    "import-rules": "node dist/scripts/import-rules.js",
    "auth-admin": "node dist/scripts/auth-admin.js",
    "validate-parsers": "node dist/scripts/validate-parsers.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "validate-detections": "node dist/scripts/validate-detections.js"
  },
  "keywords": [
    "siem",
    "syslog",
    "security",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "mmdb-lib": "^3.0.3",
    "node-nmap": "^4.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qs": "^6.16.0",
    "recheck": "^4.5.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "node-nmap": {
      "xml2js": "$xml2js"
    }
  }
}
