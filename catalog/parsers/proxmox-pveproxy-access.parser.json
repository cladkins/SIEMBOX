{
  "schema": "siembox.parser/v1",
  "name": "proxmox-pveproxy-access",
  "description": "Proxmox VE web/API proxy (pveproxy) access log: one line per HTTP request to the management UI and API on port 8006. Lines from /var/log/pveproxy/access.log forwarded as syslog (tag pveproxy) reach the parser header-stripped, as matched here. IPv4-mapped client addresses (::ffff:a.b.c.d) are unwrapped to plain IPv4; user is the authenticated Proxmox user with its realm (root@pam), absent for unauthenticated requests.",
  "parser_type": "regex",
  "priority": 36,
  "pattern": "^(?:::ffff:)?(?<client_ip>\\d{1,3}(?:\\.\\d{1,3}){3}|[0-9a-fA-F:]{2,39}) - (?:-|(?<user>[^\\s\\[\\]]{1,128})) \\[\\d{2}/\\d{2}/\\d{4}:\\d{2}:\\d{2}:\\d{2} [+-]\\d{4}\\] \"(?<method>[A-Z]{3,10}) (?<path>[^\\s\"]{1,8192}) HTTP/(?<http_version>\\d(?:\\.\\d)?)\" (?<status_code>\\d{3}) (?:(?<response_size>\\d{1,12})|-)$",
  "field_mappings": {
    "client_ip": "client_ip",
    "user": "user",
    "method": "method",
    "path": "path",
    "http_version": "http_version",
    "status_code": "status_code",
    "response_size": "response_size"
  },
  "derivations": [
    {
      "set": {
        "event": "http_access_success"
      },
      "when": {
        "status_code": {
          "matches": "^[23][0-9][0-9]$"
        }
      }
    },
    {
      "set": {
        "event": "http_access_error"
      },
      "when": {
        "status_code": {
          "matches": "^[45][0-9][0-9]$"
        }
      }
    },
    {
      "set": {
        "event": "http_access",
        "service": "pveproxy"
      }
    }
  ],
  "event_type": "http_request",
  "enabled": true,
  "test_samples": [
    {
      "description": "authenticated API call by root@pam (syslog tag pveproxy, header stripped)",
      "input": "::ffff:192.168.1.130 - root@pam [05/10/2026:11:23:14 -0500] \"GET /api2/json/cluster/resources HTTP/1.1\" 200 4231",
      "expect": {
        "source_ip": "192.168.1.130",
        "client_ip": "192.168.1.130",
        "user": "root@pam",
        "method": "GET",
        "path": "/api2/json/cluster/resources",
        "status_code": "200",
        "response_size": "4231",
        "event": "http_access_success",
        "service": "pveproxy"
      }
    },
    {
      "description": "unauthenticated static asset: no user",
      "input": "::ffff:192.168.1.130 - - [05/10/2026:11:23:11 -0500] \"GET /pwt/images/proxmox_logo.svg HTTP/1.1\" 200 1015",
      "expect": {
        "source_ip": "192.168.1.130",
        "user": null,
        "method": "GET",
        "path": "/pwt/images/proxmox_logo.svg",
        "status_code": "200",
        "event": "http_access_success",
        "service": "pveproxy"
      }
    },
    {
      "description": "query string is kept in path",
      "input": "::ffff:192.168.1.130 - - [05/10/2026:11:23:11 -0500] \"GET /proxmoxlib.js?ver=v5.2.10-t1789733295 HTTP/1.1\" 200 167526",
      "expect": {
        "source_ip": "192.168.1.130",
        "method": "GET",
        "path": "/proxmoxlib.js?ver=v5.2.10-t1789733295",
        "status_code": "200",
        "event": "http_access_success",
        "service": "pveproxy"
      }
    },
    {
      "description": "rejected login ticket request",
      "input": "::ffff:203.0.113.45 - - [05/10/2026:11:24:02 -0500] \"POST /api2/extjs/access/ticket HTTP/1.1\" 401 -",
      "expect": {
        "source_ip": "203.0.113.45",
        "method": "POST",
        "path": "/api2/extjs/access/ticket",
        "status_code": "401",
        "response_size": null,
        "event": "http_access_error",
        "service": "pveproxy"
      }
    },
    {
      "description": "an nginx access line (named month) is not claimed",
      "input": "203.0.113.5 - - [15/Jan/2024:12:00:00 +0000] \"GET /index.html HTTP/1.1\" 200 512",
      "expect": {
        "service": null,
        "event": null
      }
    }
  ]
}
