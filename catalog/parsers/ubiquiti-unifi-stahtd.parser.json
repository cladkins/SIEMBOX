{
  "schema": "siembox.parser/v1",
  "name": "ubiquiti-unifi-stahtd",
  "description": "Parses UniFi AP stahtd STA-tracker dump events (embedded JSON) — surfaces client association outcomes, notably association FAILURES and WPA auth failure counts, per client MAC and VAP.",
  "parser_type": "regex",
  "priority": 150,
  "pattern": "^\\[STA-TRACKER\\]\\.stahtd_dump_event\\(\\): (?<payload>\\{.*\\})$",
  "field_mappings": {
    "payload": "payload"
  },
  "derivations": [
    { "extract": { "source_mac": { "from": "payload", "pattern": "\"mac\":\"([0-9a-fA-F:]+)\"" } } },
    { "extract": { "interface": { "from": "payload", "pattern": "\"vap\":\"(\\w+)\"" } } },
    { "extract": { "event_type_raw": { "from": "payload", "pattern": "\"message_type\":\"([A-Z_]+)\"" } } },
    { "extract": { "assoc_outcome": { "from": "payload", "pattern": "\"event_type\":\"(\\w+)\"" } } },
    { "extract": { "wpa_auth_failures": { "from": "payload", "pattern": "\"wpa_auth_failures\":\"(\\d+)\"" } } },
    {
      "set": { "event": "wifi_assoc_failure", "event_outcome": "failure" },
      "when": { "assoc_outcome": { "equals": "failure" } }
    },
    { "set": { "event": "wifi_assoc_event" } }
  ],
  "event_type": "wifi_auth",
  "enabled": true,
  "test_samples": [
    {
      "description": "association failure with WPA auth failure count",
      "input": "[STA-TRACKER].stahtd_dump_event(): {\"message_type\":\"STA_ASSOC_TRACKER\",\"mac\":\"c0:49:ef:8c:07:2c\",\"vap\":\"wifi0ap1\",\"event_type\":\"failure\",\"assoc_status\":\"0\",\"wpa_auth_failures\":\"1\"}",
      "expect": {
        "source_mac": "c0:49:ef:8c:07:2c",
        "interface": "wifi0ap1",
        "event_type_raw": "STA_ASSOC_TRACKER",
        "assoc_outcome": "failure",
        "wpa_auth_failures": "1",
        "event": "wifi_assoc_failure",
        "event_outcome": "failure",
        "event_type": "wifi_auth",
        "service": "unifi"
      }
    },
    {
      "description": "op-first key order variant (U7 firmware)",
      "input": "[STA-TRACKER].stahtd_dump_event(): {\"op\":\"event\",\"message_type\":\"STA_ASSOC_TRACKER\",\"event_type\":\"failure\",\"mac\":\"c0:49:ef:8c:07:2c\",\"vap\":\"wifi0ap5\",\"assoc_status\":\"0\",\"wpa_auth_failures\":\"2\"}",
      "expect": {
        "interface": "wifi0ap5",
        "assoc_outcome": "failure",
        "wpa_auth_failures": "2",
        "event": "wifi_assoc_failure"
      }
    },
    {
      "description": "tightness guard: non-stahtd bracketed line must NOT match",
      "input": "[STA-TRACKER] some unrelated line without the dump call",
      "expect": { "payload": null, "event": null }
    }
  ],
  "metadata": {
    "author": "cladkins",
    "log_source": "UniFi AP (U6/U7 series) stahtd STA tracker via remote syslog",
    "tags": ["unifi", "ubiquiti", "wifi", "wireless", "authentication"],
    "references": ["https://help.ui.com/hc/en-us/articles/204959834"]
  }
}
