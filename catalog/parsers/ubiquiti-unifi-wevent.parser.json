{
  "schema": "siembox.parser/v1",
  "name": "ubiquiti-unifi-wevent",
  "description": "Parses UniFi AP wevent client session events (EVENT_STA_JOIN / EVENT_STA_LEAVE) — the cleanest join/leave signal per client MAC and VAP.",
  "parser_type": "regex",
  "priority": 150,
  "pattern": "^wevent\\.ubnt_custom_event\\(\\): (?<wevent>EVENT_[A-Z_]+) (?<vap>\\w+): (?<sta_mac>[0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5}) / (?<radio>\\d+)$",
  "field_mappings": {
    "wevent": "event_type_raw",
    "vap": "interface",
    "sta_mac": "source_mac",
    "radio": "radio"
  },
  "derivations": [
    {
      "set": { "event": "wifi_sta_join", "action": "connect" },
      "when": { "event_type_raw": { "equals": "EVENT_STA_JOIN" } }
    },
    {
      "set": { "event": "wifi_sta_leave", "action": "disconnect" },
      "when": { "event_type_raw": { "equals": "EVENT_STA_LEAVE" } }
    },
    { "set": { "event": "wifi_event" } }
  ],
  "event_type": "wifi_session",
  "enabled": true,
  "test_samples": [
    {
      "description": "client joined a VAP",
      "input": "wevent.ubnt_custom_event(): EVENT_STA_JOIN wifi0ap1: c0:49:ef:8c:07:2c / 1",
      "expect": {
        "event_type_raw": "EVENT_STA_JOIN",
        "interface": "wifi0ap1",
        "source_mac": "c0:49:ef:8c:07:2c",
        "radio": "1",
        "event": "wifi_sta_join",
        "action": "connect",
        "event_type": "wifi_session",
        "service": "unifi"
      }
    },
    {
      "description": "client left a VAP",
      "input": "wevent.ubnt_custom_event(): EVENT_STA_LEAVE wifi0ap5: c0:49:ef:8c:07:2c / 6",
      "expect": {
        "event_type_raw": "EVENT_STA_LEAVE",
        "interface": "wifi0ap5",
        "event": "wifi_sta_leave",
        "action": "disconnect"
      }
    },
    {
      "description": "tightness guard: hostapd STA line must NOT match",
      "input": "wifi0ap5: STA c0:49:ef:8c:07:2c IEEE 802.11: disassociated",
      "expect": { "event_type_raw": null, "event": null }
    }
  ],
  "metadata": {
    "author": "cladkins",
    "log_source": "UniFi AP (U6/U7 series) wevent daemon via remote syslog",
    "tags": ["unifi", "ubiquiti", "wifi", "wireless", "session"],
    "references": ["https://help.ui.com/hc/en-us/articles/204959834"]
  }
}
