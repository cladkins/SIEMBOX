# The backend API. nginx reaches it over a unix socket on the `api-socket`
# volume, which only the backend and frontend containers mount (compose.yaml,
# compose.prod.yaml). Requests arriving on that socket are the only ones whose
# X-Forwarded-For the backend believes without configuration (plus whatever its
# TRUSTED_PROXIES lists), so the UI's users keep their real client addresses
# while direct callers on :8421 can't pick one.
#
# BACKEND_UPSTREAM is the fallback: nginx uses it when the socket is missing or
# refuses (a compose file without the volume, an older backend image, a backend
# restart), or after a request on the socket timed out, and tries the socket
# again 30 s later (each worker on its own). It is substituted at container
# start (see frontend/Dockerfile): the Compose default is the backend's
# Docker-DNS name `backend:8421`, and `host.docker.internal:8421` when the
# backend runs with network_mode: host (see DEPLOYMENT.md's "Log Discovery and
# Network Visibility" section) -- still required there, because nginx resolves
# upstream names when it starts. Bare token deliberately, no ${VAR:-default}:
# envsubst doesn't support that syntax, the default lives at the Compose layer.
#
# max_fails=0 keeps the fallback from ever being marked down. Otherwise, once
# a backend restart had failed both servers, nginx would answer 502 ("no live
# upstreams") for up to 10 s after the backend was back.
upstream siembox_api {
    server unix:/run/siembox/api.sock max_fails=1 fail_timeout=30s;
    server ${BACKEND_UPSTREAM} backup max_fails=0;
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Vue.js SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the SPA entry point. Otherwise a browser-cached index.html keeps
    # referencing hashed JS/CSS chunks that were deleted on the next deploy, so those
    # requests 404 and the app fails to boot (blank/black page) — and the stale doc
    # keeps serving the old bundle. The hashed assets below stay immutable, so this is
    # cheap (one revalidation per load). The try_files fallback re-enters location
    # matching, so deep-route refreshes hit this block too. A nested add_header
    # replaces inherited ones, so the security headers are re-declared here.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    # Wall displays (src/display): their own page, never the SPA's index.html,
    # so the main app's router guard and session handling never run on a
    # display link (docs/architecture/BIG-DISPLAY.md §4.4). The link's secret is
    # in the URL fragment (/display#k=...), which browsers never send, so it
    # never reaches nginx or its access log; the page sends it to the API in
    # the X-Display-Token header, which proxy_pass below forwards unchanged.
    # The nested add_header replaces the inherited ones, so the security
    # headers are re-declared, plus a CSP: the page loads only its own hashed
    # scripts and styles and talks only to this origin.
    location = /display {
        try_files /display.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;
    }
    # /display/#k=... (trailing slash) must not fall through to the SPA; the
    # browser keeps the fragment across the redirect.
    location ^~ /display/ { return 301 /display; }
    # The page only ever loads through /display, with the headers above.
    location = /display.html { return 404; }

    # Proxy API requests to the backend (the siembox_api upstream above).
    location /api {
        proxy_pass http://siembox_api;
        # Send a request again, to the fallback, only when connecting to the
        # socket failed: without "timeout", a slow request (the AI builder can
        # take minutes) is never sent a second time, and a POST is only retried
        # if nothing was sent. nginx still counts a timeout (or an invalid
        # response header) against the socket whatever this lists, so after one
        # the worker also uses the fallback for 30 s.
        proxy_next_upstream error;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        # Load-bearing: the backend takes the client address from the last
        # X-Forwarded-For entry, which $proxy_add_x_forwarded_for sets to the
        # address nginx saw ($remote_addr). Never pass the client's own
        # X-Forwarded-For through unchanged, or every client could pick its
        # address. X-Real-IP carries the same address for logs and tools.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        # The AI builder runs an auto-refine loop of several model calls and the
        # AI Analyst a tool loop with an admin-set time budget (up to 240 s, plus
        # its 120 s answer call: backend/src/services/ai/aiBudgets.ts); default
        # 60s would 504 them. Allow long-running requests: 420 s, a margin over
        # the longest run (360 s). The browser waits 415 s (services/api.ts).
        proxy_connect_timeout 10s;
        proxy_send_timeout 420s;
        proxy_read_timeout 420s;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
