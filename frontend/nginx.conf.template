# The backend API. nginx reaches it over a unix socket on the `api-socket`
# volume, which only the backend and frontend containers mount (compose.yaml,
# compose.prod.yaml). Requests arriving on that socket are the only ones whose
# X-Forwarded-For the backend believes without configuration (plus whatever its
# TRUSTED_PROXIES lists), so the UI's users keep their real client addresses
# while direct callers on :8421 can't pick one.
#
# BACKEND_UPSTREAM is the fallback: nginx uses it when the socket is missing or
# refuses (a compose file without the volume, an older backend image, a backend
# restart) and tries the socket again 30 s later. It is substituted at container
# start (see frontend/Dockerfile): the Compose default is the backend's
# Docker-DNS name `backend:8421`, and `host.docker.internal:8421` when the
# backend runs with network_mode: host (see DEPLOYMENT.md's "Log Discovery and
# Network Visibility" section) -- still required there, because nginx resolves
# upstream names when it starts. Bare token deliberately, no ${VAR:-default}:
# envsubst doesn't support that syntax, the default lives at the Compose layer.
#
# max_fails=0 keeps the fallback from ever being marked down. Otherwise, once
# a backend restart had failed both servers, nginx would answer 502 ("no live
# upstreams") for up to 10 s after the backend was back.
upstream siembox_api {
    server unix:/run/siembox/api.sock max_fails=1 fail_timeout=30s;
    server ${BACKEND_UPSTREAM} backup max_fails=0;
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Vue.js SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the SPA entry point. Otherwise a browser-cached index.html keeps
    # referencing hashed JS/CSS chunks that were deleted on the next deploy, so those
    # requests 404 and the app fails to boot (blank/black page) — and the stale doc
    # keeps serving the old bundle. The hashed assets below stay immutable, so this is
    # cheap (one revalidation per load). The try_files fallback re-enters location
    # matching, so deep-route refreshes hit this block too. A nested add_header
    # replaces inherited ones, so the security headers are re-declared here.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    # Proxy API requests to the backend (the siembox_api upstream above).
    location /api {
        proxy_pass http://siembox_api;
        # Move to the fallback only when the socket can't be reached. Without
        # "timeout", a slow request (the AI builder can take minutes) is never
        # sent a second time, and a POST is only retried if nothing was sent.
        proxy_next_upstream error;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        # Load-bearing: the backend takes the client address from the last
        # X-Forwarded-For entry, which $proxy_add_x_forwarded_for sets to the
        # address nginx saw ($remote_addr). Never pass the client's own
        # X-Forwarded-For through unchanged, or every client could pick its
        # address. X-Real-IP carries the same address for logs and tools.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        # The AI builder runs an auto-refine loop of several model calls and can
        # take a while; default 60s would 504 it. Allow long-running requests.
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
