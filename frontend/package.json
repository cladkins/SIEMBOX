{
  "name": "siembox-frontend",
  "version": "4.2.1",
  "description": "SIEMBox Frontend - Security monitoring dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "build:check": "vue-tsc && vite build",
    "check:legal-comments": "node scripts/check-legal-comments.mjs",
    "check:graph-chunk": "node scripts/check-graph-chunk.mjs",
    "test:unit": "node --test src/graph/*.test.ts src/utils/*.test.ts src/display/*.test.ts src/display/board/*.test.ts",
    "check:display-bundle": "node scripts/check-display-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "chartjs-chart-geo": "^4.3.6",
    "cytoscape": "^3.34.4",
    "date-fns": "^3.0.6",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.8",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.3",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
